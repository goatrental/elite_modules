#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Book an appointment"
msgstr "Rezervace termínu"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Choose the reason for your visit and a free appointment. You will receive a confirmation by email."
msgstr "Vyberte důvod návštěvy a volný termín. Potvrzení vám přijde e-mailem."

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
