#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Duty schedule"
msgstr "Rozpis služeb"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Duty schedule of the Elite Vet veterinary clinic in Karlovy Vary — a monthly calendar with morning and afternoon shifts and the weekend shifts of our doctors."
msgstr "Rozpis ordinačních služeb veterinární kliniky Elite Vet Karlovy Vary — měsíční kalendář s ranní a odpolední službou a s víkendovými službami našich lékařek."

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Duty schedule | Elite Vet Karlovy Vary"
msgstr "Rozpis služeb | Elite Vet Karlovy Vary"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Elite Vet booking system"
msgstr "Rezervační systém Elite Vet"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Friday"
msgstr "Pátek"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Menu"
msgstr "Menu"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Monday"
msgstr "Pondělí"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Monday – Friday · 8:00–20:00"
msgstr "Pondělí – Pátek · 8:00–20:00"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "On weekdays we alternate morning and afternoon shifts; at the weekend one doctor covers the whole opening time. Hover over a name to see the hours she is seeing patients that day."
msgstr "Ve všední dny se u nás střídá ranní a odpolední služba, o víkendu slouží jedna lékařka po celou provozní dobu. Najeďte na jméno a ukáže se vám, v jakých hodinách ten den ordinuje."

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Saturday"
msgstr "Sobota"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
