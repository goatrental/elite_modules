<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Polozka v menu webu. Navigace na strance se vykresluje z menu, takze
        odsud se odkaz da prejmenovat, presunout i smazat primo v Odoo
        (Web -> Upravit -> Menu), bez zasahu do kodu.
        noupdate="1": upgrade modulu uz polozku neprepise.
    -->
    <data noupdate="1">
        <record id="website_menu_rozpis" model="website.menu">
            <field name="name">Rozpis služeb</field>
            <field name="url">/rozpis-lekaru</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">50</field>
        </record>
    </data>
</odoo>
