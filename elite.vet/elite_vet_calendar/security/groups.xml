<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Vlastni kategorie a skupina, aby slo uzivateli dat pristup jen
            k rozpisu. Bez toho by aplikaci videl kazdy vnitrni uzivatel,
            protoze prava visela na base.group_user.
        -->
        <record id="module_category_elite_vet_calendar" model="ir.module.category">
            <field name="name">Rozpis služeb</field>
            <field name="description">Přístup k rozpisu služeb lékařů.</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_calendar_manager" model="res.groups">
            <field name="name">Správce rozpisu</field>
            <field name="category_id" ref="module_category_elite_vet_calendar"/>
            <field name="comment">Může zadávat směny, spravovat lékařky a typy směn.</field>
        </record>
    </data>
</odoo>
