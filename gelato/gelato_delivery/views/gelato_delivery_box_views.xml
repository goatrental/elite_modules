<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_delivery_box_view_list" model="ir.ui.view">
        <field name="name">gelato.delivery.box.list</field>
        <field name="model">gelato.delivery.box</field>
        <field name="arch" type="xml">
            <list string="Thermal boxes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="price"/>
                <field name="vat_rate" string="VAT %"/>
                <field name="max_flavors"/>
                <field name="highlight" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="gelato_delivery_box_view_form" model="ir.ui.view">
        <field name="name">gelato.delivery.box.form</field>
        <field name="model">gelato.delivery.box</field>
        <field name="arch" type="xml">
            <form string="Thermal box">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example 1 l"/>
                        </h1>
                        <field name="subtitle" placeholder="about 8 servings"/>
                    </div>
                    <group>
                        <group string="Price and contents">
                            <field name="price"/>
                            <field name="vat_rate"/>
                            <field name="volume_l"/>
                            <field name="portions"/>
                            <field name="max_flavors"/>
                        </group>
                        <group string="How it looks on the website">
                            <field name="sequence"/>
                            <field name="highlight"/>
                            <field name="highlight_label" invisible="not highlight"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Bullet points on the card">
                        <field name="features" nolabel="1" placeholder="One bullet per line..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_delivery_box_action" model="ir.actions.act_window">
        <field name="name">Thermal boxes</field>
        <field name="res_model">gelato.delivery.box</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first thermal box.</p>
            <p>Thermal boxes are what the customer picks on the delivery page. Prices and bullet points are changed here, not in the website code.</p>
        </field>
    </record>

</odoo>
