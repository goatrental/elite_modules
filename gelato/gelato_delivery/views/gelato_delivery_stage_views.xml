<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gelato_delivery_stage_view_list" model="ir.ui.view">
        <field name="name">gelato.delivery.stage.list</field>
        <field name="model">gelato.delivery.stage</field>
        <field name="arch" type="xml">
            <list string="Board columns">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="mail_enabled" widget="boolean_toggle" string="Emails the customer"/>
                <field name="sms_enabled" widget="boolean_toggle" string="Texts the customer"/>
                <field name="mail_subject" string="Subject" optional="show"/>
                <field name="sms_body" string="Text message" optional="hide"/>
                <!-- Set on the column itself. They decide revenue and the
                     look of the board, not what the customer receives, so
                     they stay out of the way here. -->
                <field name="is_done" widget="boolean_toggle" string="Completed" optional="hide"/>
                <field name="fold" widget="boolean_toggle" string="Folded" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="gelato_delivery_stage_view_form" model="ir.ui.view">
        <field name="name">gelato.delivery.stage.form</field>
        <field name="model">gelato.delivery.stage</field>
        <field name="arch" type="xml">
            <form string="Board column">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="For example On the way"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="is_done"/>
                        <field name="fold"/>
                        <field name="mail_enabled"/>
                        <field name="sms_enabled"/>
                    </group>
                    <group string="Email to the customer" invisible="not mail_enabled">
                        <field name="mail_subject" placeholder="Your order {{ object.name }} is on its way"/>
                        <field name="mail_body"/>
                    </group>
                    <group string="Text message to the customer" invisible="not sms_enabled">
                        <field name="sms_body" nolabel="1"
                               placeholder="Gelato! We are on our way with order {{ object.name }}. We will ring when we are outside."/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not sms_enabled">
                        A text over <b>160 characters</b> is charged as two messages.
                        Texts only go out once your SMS provider is connected in
                        Odoo - until then nothing is sent and nothing is charged.
                    </div>
                    <div class="alert alert-info" role="status" invisible="not mail_enabled and not sms_enabled">
                        You can drop these into the subject and the text, they fill themselves in:
                        <br/>
                        <b>{{ object.name }}</b> the order number ·
                        <b>{{ object.customer_name }}</b> the customer's name ·
                        <b>{{ object.delivery_address }}</b> the address ·
                        <b>{{ object.amount_total }}</b> the total.
                        <br/>
                        Each goes out once per column. Dragging a card out and back
                        will not send it again.
                    </div>
                    <div class="alert alert-secondary" role="status" invisible="mail_enabled or sms_enabled">
                        This column is only your own step - the customer hears
                        <b>nothing</b> when an order lands in it. Switch
                        <b>Email the customer</b> or <b>Text the customer</b> on
                        if you want something sent.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gelato_delivery_stage_action" model="ir.actions.act_window">
        <field name="name">Board columns</field>
        <field name="res_model">gelato.delivery.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Create your first column.</p>
            <p>Columns are the steps an order goes through on the board. Any of them can email or text the customer the moment an order is dragged in.</p>
        </field>
    </record>

</odoo>
