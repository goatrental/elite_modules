<?xml version="1.0" encoding="utf-8"?>
<!--
    Starting columns for the order board. The shop renames them, reorders
    them and adds its own - they are data, not code.

    Two columns email the customer on their own: the confirmation that the
    order arrived, and the moment the driver leaves. Confirmed and Delivered
    carry a ready text as well, but switched off - flip the switch on the
    column if you want them sent too.

    "On the way" also carries a ready text message, switched off. Texts cost
    money with the SMS provider, so turning it on is the shop's decision.
-->
<odoo noupdate="1">

    <record id="stage_received" model="gelato.delivery.stage">
        <field name="name">Received</field>
        <field name="sequence">10</field>
        <field name="mail_enabled" eval="True"/>
        <field name="mail_subject">We have your order {{ object.name }}</field>
        <field name="mail_body" type="html">
            <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;">
                <p>Hello {{ object.customer_name }},</p>
                <p>
                    thank you for your order. We have it and we will get back to you
                    shortly to confirm the time and the price.
                </p>
                <p>
                    Order number: <strong>{{ object.name }}</strong><br/>
                    Delivery to: {{ object.delivery_address }}<br/>
                    Total: <strong>{{ object.amount_total }} CZK</strong>
                </p>
                <p>You pay on handover, in cash or by card. Nothing up front.</p>
                <p>
                    Gelato! Karlovy Vary<br/>
                    Sokolovská 101, Rybáře · +420 773 09 58 09
                </p>
            </div>
        </field>
    </record>

    <record id="stage_confirmed" model="gelato.delivery.stage">
        <field name="name">Confirmed</field>
        <field name="sequence">20</field>
        <field name="mail_subject">Your order {{ object.name }} is confirmed</field>
        <field name="mail_body" type="html">
            <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;">
                <p>Hello {{ object.customer_name }},</p>
                <p>your order is confirmed and we are getting it ready.</p>
                <p>
                    Order number: <strong>{{ object.name }}</strong><br/>
                    Delivery to: {{ object.delivery_address }}<br/>
                    Total: <strong>{{ object.amount_total }} CZK</strong>
                </p>
                <p>
                    Gelato! Karlovy Vary<br/>
                    Sokolovská 101, Rybáře · +420 773 09 58 09
                </p>
            </div>
        </field>
    </record>

    <record id="stage_on_the_way" model="gelato.delivery.stage">
        <field name="name">On the way</field>
        <field name="sequence">30</field>
        <field name="mail_enabled" eval="True"/>
        <field name="sms_body">Gelato! We are on our way with order {{ object.name }}. We will ring when we are outside.</field>
        <field name="mail_subject">We are on our way with order {{ object.name }}</field>
        <field name="mail_body" type="html">
            <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;">
                <p>Hello {{ object.customer_name }},</p>
                <p>
                    the gelato is in the box and the driver has left. We are on
                    our way to {{ object.delivery_address }}.
                </p>
                <p>Keep your phone close - we ring when we are outside.</p>
                <p>
                    Gelato! Karlovy Vary<br/>
                    Sokolovská 101, Rybáře · +420 773 09 58 09
                </p>
            </div>
        </field>
    </record>

    <record id="stage_delivered" model="gelato.delivery.stage">
        <field name="name">Delivered</field>
        <field name="sequence">40</field>
        <field name="is_done" eval="True"/>
        <field name="mail_subject">Thank you for your order {{ object.name }}</field>
        <field name="mail_body" type="html">
            <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;">
                <p>Hello {{ object.customer_name }},</p>
                <p>
                    thank you, and we hope it tasted the way it should. If
                    anything was not right, call us and we will sort it out.
                </p>
                <p>
                    Gelato! Karlovy Vary<br/>
                    Sokolovská 101, Rybáře · +420 773 09 58 09
                </p>
            </div>
        </field>
    </record>

    <record id="stage_cancelled" model="gelato.delivery.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">90</field>
        <field name="fold" eval="True"/>
    </record>

</odoo>
