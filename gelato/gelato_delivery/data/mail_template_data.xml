<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_template_delivery_order" model="mail.template">
        <field name="name">Delivery: new order</field>
        <field name="model_id" ref="model_gelato_delivery_order"/>
        <field name="subject">New delivery order {{ object.name }}</field>
        <field name="email_from">{{ (object.website_id.company_id.email or user.email_formatted) }}</field>
        <field name="email_to">{{ object.website_id.gelato_delivery_email or 'gelatokv@seznam.cz' }}</field>
        <field name="reply_to">{{ object.customer_email or '' }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;">
                <h2 style="margin: 0 0 16px; font-size: 20px;">
                    New delivery order
                    <span t-out="object.name">ROZ/2026/0001</span>
                </h2>

                <h3 style="margin: 20px 0 6px; font-size: 15px;">When and where</h3>
                <table cellpadding="4" style="border-collapse: collapse;">
                    <tr>
                        <td style="color: #666;">Date</td>
                        <td><strong t-out="object.delivery_date">1/1/2026</strong></td>
                    </tr>
                    <tr>
                        <td style="color: #666;">Time</td>
                        <td><strong t-out="object.time_slot_label()">As soon as possible</strong></td>
                    </tr>
                    <tr>
                        <td style="color: #666;">Address</td>
                        <td><strong t-out="object.delivery_address">Street 1</strong></td>
                    </tr>
                </table>

                <h3 style="margin: 20px 0 6px; font-size: 15px;">Order</h3>
                <table cellpadding="4" style="border-collapse: collapse;">
                    <tr>
                        <td style="color: #666;">Thermal box</td>
                        <td><strong t-out="object.box_id.name">1 l</strong></td>
                    </tr>
                    <tr>
                        <td style="color: #666;">Flavours</td>
                        <td><strong t-out="object.flavor_names()">Vanilla</strong></td>
                    </tr>
                    <tr t-if="object.addon_line_ids">
                        <td style="color: #666;">Extras</td>
                        <td>
                            <t t-foreach="object.addon_line_ids" t-as="line">
                                <div>
                                    <span t-out="line.quantity">1</span>×
                                    <span t-out="line.addon_id.name">Prosecco</span>
                                </div>
                            </t>
                        </td>
                    </tr>
                    <tr t-if="object.note">
                        <td style="color: #666;">Note</td>
                        <td t-out="object.note">No nuts</td>
                    </tr>
                </table>

                <h3 style="margin: 20px 0 6px; font-size: 15px;">Price</h3>
                <table cellpadding="4" style="border-collapse: collapse;">
                    <tr>
                        <td style="color: #666;">Subtotal</td>
                        <td><t t-out="object.amount_subtotal">450</t> CZK</td>
                    </tr>
                    <tr t-if="object.amount_discount">
                        <td style="color: #666;">
                            Discount
                            <t t-if="object.promo_code_id">
                                (<t t-out="object.promo_code_id.code">ZIMA10</t>)
                            </t>
                        </td>
                        <td>-<t t-out="object.amount_discount">45</t> CZK</td>
                    </tr>
                    <tr t-if="object.delivery_fee">
                        <td style="color: #666;">Delivery</td>
                        <td><t t-out="object.delivery_fee">0</t> CZK</td>
                    </tr>
                    <tr>
                        <td style="color: #666;"><strong>Total</strong></td>
                        <td><strong><t t-out="object.amount_total">405</t> CZK</strong></td>
                    </tr>
                </table>

                <t t-set="vat_rows" t-value="object.vat_breakdown()"/>
                <t t-if="object.amount_vat">
                    <h3 style="margin: 20px 0 6px; font-size: 15px;">VAT (included in the total)</h3>
                    <table cellpadding="4" style="border-collapse: collapse;">
                        <tr style="color: #666;">
                            <td>Rate</td>
                            <td>Net</td>
                            <td>VAT</td>
                            <td>Gross</td>
                        </tr>
                        <t t-foreach="vat_rows" t-as="row">
                            <tr>
                                <td><t t-out="row['rate']">21</t> %</td>
                                <td><t t-out="row['base']">100</t></td>
                                <td><t t-out="row['vat']">21</t></td>
                                <td><t t-out="row['gross']">121</t></td>
                            </tr>
                        </t>
                        <tr>
                            <td style="color: #666;"><strong>Net of VAT</strong></td>
                            <td colspan="3"><strong><t t-out="object.amount_untaxed">334</t> CZK</strong></td>
                        </tr>
                    </table>
                </t>

                <h3 style="margin: 20px 0 6px; font-size: 15px;">Customer</h3>
                <table cellpadding="4" style="border-collapse: collapse;">
                    <tr>
                        <td style="color: #666;">Name</td>
                        <td><strong t-out="object.customer_name">Jan Novak</strong></td>
                    </tr>
                    <tr>
                        <td style="color: #666;">Phone</td>
                        <td><strong t-out="object.customer_phone">+420 000 000 000</strong></td>
                    </tr>
                    <tr t-if="object.customer_email">
                        <td style="color: #666;">Email</td>
                        <td t-out="object.customer_email">jan@email.cz</td>
                    </tr>
                </table>
            </div>
        </field>
        <field name="lang">{{ object.website_id.default_lang_id.code }}</field>
    </record>

</odoo>
