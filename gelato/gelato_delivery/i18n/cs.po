#. module: gelato_delivery
#: model:gelato.delivery.stage,mail_body:gelato_delivery.stage_delivered
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Hello {{ object.customer_name }},</p>\n"
"                <p>\n"
"                    thank you, and we hope it tasted the way it should. If\n"
"                    anything was not right, call us and we will sort it out.\n"
"                </p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Dobrý den {{ object.customer_name }},</p>\n"
"                <p>\n"
"                    děkujeme a doufáme, že chutnalo tak, jak má. Kdyby něco\n"
"                    nebylo v pořádku, zavolejte nám a domluvíme se.\n"
"                </p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>"

#. module: gelato_delivery
#: model:gelato.delivery.stage,mail_body:gelato_delivery.stage_on_the_way
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Hello {{ object.customer_name }},</p>\n"
"                <p>\n"
"                    the gelato is in the box and the driver has left. We are on\n"
"                    our way to {{ object.delivery_address }}.\n"
"                </p>\n"
"                <p>Keep your phone close - we ring when we are outside.</p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Dobrý den {{ object.customer_name }},</p>\n"
"                <p>\n"
"                    gelato je v termoboxu a řidič vyrazil. Jedeme na\n"
"                    adresu {{ object.delivery_address }}.\n"
"                </p>\n"
"                <p>Mějte telefon po ruce – zavoláme, až budeme před domem.</p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>"

#. module: gelato_delivery
#: model:gelato.delivery.stage,mail_body:gelato_delivery.stage_confirmed
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Hello {{ object.customer_name }},</p>\n"
"                <p>your order is confirmed and we are getting it ready.</p>\n"
"                <p>\n"
"                    Order number: <strong>{{ object.name }}</strong><br>\n"
"                    Delivery to: {{ object.delivery_address }}<br>\n"
"                    Total: <strong>{{ object.amount_total }} CZK</strong>\n"
"                </p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <p>Dobrý den {{ object.customer_name }},</p>\n"
"                <p>objednávku máme potvrzenou a chystáme ji.</p>\n"
"                <p>\n"
"                    Číslo objednávky: <strong>{{ object.name }}</strong><br>\n"
"                    Doručíme na: {{ object.delivery_address }}<br>\n"
"                    Celkem: <strong>{{ object.amount_total }} Kč</strong>\n"
"                </p>\n"
"                <p>\n"
"                    Gelato! Karlovy Vary<br>\n"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09\n"
"                </p>\n"
"            </div>"

#. module: gelato_delivery
#: model:gelato.delivery.stage,mail_body:gelato_delivery.stage_received
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; "
"color: #1a1a1a;\">                <p>Dobrý den {{ object.customer_name "
"}},</p>                <p>                    děkujeme za objednávku. Máme "
"ji a co nevidět se vám ozveme, abychom potvrdili termín a cenu."
"                </p>                <p>                    Číslo objednávky:"
" <strong>{{ object.name }}</strong><br/>                    Doručení na: {{ "
"object.delivery_address }}<br/>                    Celkem: <strong>{{ "
"object.amount_total }} Kč</strong>                </p>                "
"<p>Platíte až při předání, hotově nebo kartou. Nic dopředu.</p>"
"                <p>                    Gelato! Karlovy Vary<br/>"
"                    Sokolovská 101, Rybáře · +420 773 09 58 09"
"                </p>            </div>"
msgstr ""

