#. module: gelato_delivery
#: model:mail.template,body_html:gelato_delivery.mail_template_delivery_order
msgid ""
"<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1a1a1a;\">\n"
"                <h2 style=\"margin: 0 0 16px; font-size: 20px;\">\n"
"                    New delivery order\n"
"                    <span t-out=\"object.name\">ROZ/2026/0001</span>\n"
"                </h2>\n"
"\n"
"                <h3 style=\"margin: 20px 0 6px; font-size: 15px;\">When and where</h3>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Date</td>\n"
"                        <td><strong t-out=\"object.delivery_date\">1/1/2026</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Time</td>\n"
"                        <td><strong t-out=\"object.time_slot_label()\">As soon as possible</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Address</td>\n"
"                        <td><strong t-out=\"object.delivery_address\">Street 1</strong></td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <h3 style=\"margin: 20px 0 6px; font-size: 15px;\">Order</h3>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Thermal box</td>\n"
"                        <td><strong t-out=\"object.box_id.name\">1 l</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Flavours</td>\n"
"                        <td><strong t-out=\"object.flavor_names()\">Vanilla</strong></td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.addon_line_ids\">\n"
"                        <td style=\"color: #666;\">Extras</td>\n"
"                        <td>\n"
"                            <t t-foreach=\"object.addon_line_ids\" t-as=\"line\">\n"
"                                <div>\n"
"                                    <span t-out=\"line.quantity\">1</span>×\n"
"                                    <span t-out=\"line.addon_id.name\">Prosecco</span>\n"
"                                </div>\n"
"                            </t>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.note\">\n"
"                        <td style=\"color: #666;\">Note</td>\n"
"                        <td t-out=\"object.note\">No nuts</td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <h3 style=\"margin: 20px 0 6px; font-size: 15px;\">Price</h3>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Subtotal</td>\n"
"                        <td><t t-out=\"object.amount_subtotal\">450</t> CZK</td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.amount_discount\">\n"
"                        <td style=\"color: #666;\">\n"
"                            Discount\n"
"                            <t t-if=\"object.promo_code_id\">\n"
"                                (<t t-out=\"object.promo_code_id.code\">ZIMA10</t>)\n"
"                            </t>\n"
"                        </td>\n"
"                        <td>-<t t-out=\"object.amount_discount\">45</t> CZK</td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.delivery_fee\">\n"
"                        <td style=\"color: #666;\">Delivery</td>\n"
"                        <td><t t-out=\"object.delivery_fee\">0</t> CZK</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\"><strong>Total</strong></td>\n"
"                        <td><strong><t t-out=\"object.amount_total\">405</t> CZK</strong></td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <t t-set=\"vat_rows\" t-value=\"object.vat_breakdown()\"/>\n"
"                <t t-if=\"object.amount_vat\">\n"
"                    <h3 style=\"margin: 20px 0 6px; font-size: 15px;\">VAT (included in the total)</h3>\n"
"                    <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                        <tr style=\"color: #666;\">\n"
"                            <td>Rate</td>\n"
"                            <td>Net</td>\n"
"                            <td>VAT</td>\n"
"                            <td>Gross</td>\n"
"                        </tr>\n"
"                        <t t-foreach=\"vat_rows\" t-as=\"row\">\n"
"                            <tr>\n"
"                                <td><t t-out=\"row['rate']\">21</t> %</td>\n"
"                                <td><t t-out=\"row['base']\">100</t></td>\n"
"                                <td><t t-out=\"row['vat']\">21</t></td>\n"
"                                <td><t t-out=\"row['gross']\">121</t></td>\n"
"                            </tr>\n"
"                        </t>\n"
"                        <tr>\n"
"                            <td style=\"color: #666;\"><strong>Net of VAT</strong></td>\n"
"                            <td colspan=\"3\"><strong><t t-out=\"object.amount_untaxed\">334</t> CZK</strong></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"                <h3 style=\"margin: 20px 0 6px; font-size: 15px;\">Customer</h3>\n"
"                <table cellpadding=\"4\" style=\"border-collapse: collapse;\">\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Name</td>\n"
"                        <td><strong t-out=\"object.customer_name\">Jan Novak</strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"color: #666;\">Phone</td>\n"
"                        <td><strong t-out=\"object.customer_phone\">+420 000 000 000</strong></td>\n"
"                    </tr>\n"
"                    <tr t-if=\"object.customer_email\">\n"
"                        <td style=\"color: #666;\">Email</td>\n"
"                        <td t-out=\"object.customer_email\">jan@email.cz</td>\n"
"                    </tr>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""
