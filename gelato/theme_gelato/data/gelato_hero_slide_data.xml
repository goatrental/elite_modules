<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data noupdate="1">

    <record id="hero_slide_1" model="gelato.hero.slide">
        <field name="name">Rodinná firma</field>
        <field name="headline">Řemeslné</field>
        <field name="headline_accent">zmrzlinářství</field>
        <field name="subtitle"> </field>
        <field name="button_text">Navštivte nás</field>
        <field name="button_url">/#pobocka</field>
        <field name="sequence">1</field>
        <field name="display_time">10.0</field>
    </record>

    <record id="hero_slide_2" model="gelato.hero.slide">
        <field name="name">Výroba</field>
        <field name="headline">Vyberte si</field>
        <field name="headline_accent">své příchutě</field>
        <field name="subtitle"> </field>
        <field name="button_text">Mám zájem</field>
        <field name="button_url">/#poptavka</field>
        <field name="image" type="base64" file="theme_gelato/static/src/img/hero-slide-vyroba.png"/>
        <field name="sequence">2</field>
        <field name="display_time">3.0</field>
    </record>

    <record id="hero_slide_3" model="gelato.hero.slide">
        <field name="name">Catering</field>
        <field name="headline">Pro významné</field>
        <field name="headline_accent">události</field>
        <field name="button_text">Zjistit víc</field>
        <field name="button_url">/#poptavka</field>
        <field name="image" type="base64" file="theme_gelato/static/src/img/hero-slide-catering.webp"/>
        <field name="sequence">3</field>
        <field name="display_time">8.0</field>
    </record>

    <record id="hero_slide_4" model="gelato.hero.slide">
        <field name="name">Distribuce</field>
        <field name="headline">Kompletní</field>
        <field name="headline_accent">servis</field>
        <field name="button_text">Zjistit víc</field>
        <field name="button_url">/#poptavka</field>
        <field name="image" type="base64" file="theme_gelato/static/src/img/hero-slide-distribuce.webp"/>
        <field name="sequence">4</field>
        <field name="display_time">8.0</field>
    </record>


    <!-- The delivery page gets its own slide: the front page's wording
         ("come and visit us") makes no sense above an order form. The
         gelateria can add more of its own next to it - a slide with
         /rozvoz under "Only on these addresses" lands here. -->
    <record id="hero_slide_rozvoz" model="gelato.hero.slide">
        <field name="name">Rozvoz po Karlových Varech</field>
        <field name="headline">Zmrzlinu</field>
        <field name="headline_accent">až ke dveřím</field>
        <field name="subtitle"> </field>
        <field name="button_text">Objednat</field>
        <field name="button_url">/rozvoz#objednavka</field>
        <field name="page_url">/rozvoz</field>
        <field name="image" type="base64" file="theme_gelato/static/src/img/hero-slide-distribuce.webp"/>
        <field name="sequence">1</field>
        <field name="display_time">10.0</field>
    </record>
</data>
</odoo>
